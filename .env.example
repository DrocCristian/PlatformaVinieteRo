APP_URL=http://127.0.0.1:3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Accounts, trips, support and preferences do not need service-role credentials.
# Optional sandbox only; never use sk_live_ or enable real payments.
COMMERCE_MODE=disabled
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ISSUANCE_WORKER_SECRET=
MAP_TILE_URL=
ROUTING_API_URL=

# Enable only after APIs, public copy and launch approval are complete; rebuild required.
PUBLIC_INDEXING_ENABLED=false

# Enable only after applying and testing fleet migration.
FLEET_WORKSPACE_ENABLED=false

# Enable after purchase_workspace migration and ownership tests.
PURCHASE_WORKSPACE_ENABLED=false
